#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menu "FRAMEWORK Test Code"

    config FRAMEWORK_TEST_ENABLED
        bool "\"Framework Test\" Application"
        help
            Select this option to enable framework test.
    
    if FRAMEWORK_TEST_ENABLED

        config FRAMEWORK_TEST_MODULE
            bool "Framework Test Module"
            default n
            ---help---
                Enable the \"Framework Test\" Module

        config FRAMEWORK_TEST_PROGNAME
            string "Program name"
            default "framework_test"
            ---help---
                This is the name of the program that will be used when the NSH ELF
                program is installed.

        config FRAMEWORK_TEST_PRIORITY
            int "FRAMEWORK_TEST task priority"
            default 100

        config FRAMEWORK_TEST_STACKSIZE
            int "FRAMEWORK_TEST stack size"
            default DEFAULT_TASK_STACKSIZE

        config BT_TEST_ENABLED
            bool "Bluetooth Test"
            help
                Select this option to enable Bluetooth Test.

    endif

    menu "Bluedroid Test Options"
        depends on BT_TEST_ENABLED
        source "vendor/boss/app/boss1-app/watch-ui/framework/test/test_bluedroid/Kconfig"
    endmenu

endmenu